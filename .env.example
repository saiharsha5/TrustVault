DATABASE_URL=postgresql+psycopg://trustvault:change-this-db-password@db:5432/trustvault
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_HTTPS_ONLY=false
BOOTSTRAP_DEMO=true
BOOTSTRAP_ADMIN_PASSWORD=change-admin-demo-password
BOOTSTRAP_OWNER_PASSWORD=change-owner-demo-password
BOOTSTRAP_VIEWER_PASSWORD=change-viewer-demo-password
MAX_UPLOAD_BYTES=10485760
STORAGE_DIR=/app/private_storage
